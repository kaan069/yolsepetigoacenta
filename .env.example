# Backend adresi. Bos birakilirsa https://api.yolsepetigo.com kullanilir.
# WebSocket adresi bundan turetilir (https -> wss).
VITE_API_URL=

# Google Maps anahtari (Maps JavaScript, Places, Geocoding, Distance Matrix)
VITE_GOOGLE_MAPS_API_KEY=

# Yeni talep formunda "Test bilgilerini doldur" butonu. Yerelde (npm run dev) zaten acik;
# yayindaki bir test ortaminda acmak icin true yapin. Canli (acentelerin kullandigi) ortamda bos birakin.
VITE_ENABLE_TEST_FILL=true
# Test sigortali telefonu; bos birakilirsa src/config.ts icindeki varsayilan numara kullanilir.
VITE_TEST_PHONE=
